# Conexão com o Postgres do Supabase.
# Pegue em: Dashboard → Project Settings → Database → Connection string →
# "Transaction pooler" (porta 6543). O pooler em modo transação é o certo
# para função sem servidor.
DATABASE_URL=postgresql://postgres.<ref>:<SENHA>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Usada para buscar as chaves públicas e conferir a assinatura do token.
SUPABASE_URL=https://kjkyyqxqrqsdozjyyuon.supabase.co

# Só em desenvolvimento. Em produção NUNCA defina:
# ALLOW_DEV_TOKENS=1
