{
    "redirects": [
        {
            "source": "/base-suporte.html",
            "destination": "/workspace/base-suporte",
            "permanent": false
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ]
}
